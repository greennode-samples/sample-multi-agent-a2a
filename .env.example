# Copy to .env and fill in. Values that still start with "change-me" are rejected at startup.
# Do not put comments after a value: `docker run --env-file` keeps them as part of the value.
# `docker compose` reads this file too (docker-compose.yml); the A2A_AGENT_* and MCP_STOCK_URL lines
# below are the addresses of the sibling containers of `docker compose --profile all`. For agents
# that run elsewhere (AgentBase runtimes) replace them with the real URLs, see the README.

# --- LLM (GreenNode AI Platform) ---
# API key created in the console: AI Platform > LLM > API Keys.
LLM_API_KEY=change-me
# OpenAI-compatible endpoint. On AgentBase Runtime this can point to the Sidecar LLM Proxy
# (http://localhost:18080); verify auth and model names with GreenNode for your runtime version.
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=z-ai/glm-5.3-flash

# --- Memory (Console > AgentBase > Memory) ---
# Memory id, e.g. memory-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx. It stores the conversation of this
# agent (checkpointer); the remote agents keep their own memory.
AGENTBASE_MEMORY_ID=change-me

# --- Stock tools over MCP ---
# Connector endpoint on the MCP Gateway: <gateway-url>/stock (the connector of sample-mcp-stock-server).
MCP_STOCK_URL=http://stock-mcp-server:8080/mcp

# --- Remote agents over A2A ---
# Comma-separated LABELS (capital letters, digits, underscores). Each label needs
# A2A_AGENT_<LABEL>_URL, the base URL of the agent (no path: its card is read from
# <url>/.well-known/agent-card.json), and may have A2A_AGENT_<LABEL>_API_KEY, the AGENT_API_KEY of
# that agent, sent as X-API-Key. Leave the key out for an agent that has none (local compose).
A2A_AGENTS=TRAVEL_BUDDY,ZALO_RESTAURANT
A2A_AGENT_TRAVEL_BUDDY_URL=http://travel-buddy:8080
# A2A_AGENT_TRAVEL_BUDDY_API_KEY=change-me
A2A_AGENT_ZALO_RESTAURANT_URL=http://zalo-restaurant:8080
# A2A_AGENT_ZALO_RESTAURANT_API_KEY=change-me
# 1: also send this runtime's IAM token as "Authorization: Bearer" to every agent. Needed when their
# Runtime Security Settings use Inbound Identity "IAM Permissions". Requires https URLs. Default 0.
# A2A_IAM_AUTH=0
# Seconds one call to a remote agent may take (1-600). The call is never repeated after a timeout.
# A2A_TIMEOUT_SECONDS=90
# 1: call the agents with message/stream and show their partial answers in the chat. Default 0.
# A2A_STREAMING=0

# --- Credentials: only for running OUTSIDE AgentBase Runtime ---
# The runtime injects them automatically. Locally, use a service account that may call Memory and
# the MCP Gateway; it is also the identity the IAM token for A2A_IAM_AUTH and the MCP calls comes from.
# GREENNODE_CLIENT_ID=
# GREENNODE_CLIENT_SECRET=

# --- Security ---
# REQUIRED for any deployment other than your own laptop. When set, /invocations, /a2a, /ready and
# /api/* need the header X-API-Key (the bundled UI asks for it). Every turn spends LLM credits and
# calls the remote agents for a user id the CLIENT chooses, so without a key anyone who reaches the
# endpoint can do both. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AGENT_API_KEY=change-me
# 1 enables the {"op":"whoami"} operation, which returns the runtime identity for the Policy Group.
# Turn it on only while setting up policies.
DEBUG_OPS=0

# --- A2A server (this agent can be called by other agents) ---
# Public URL of this runtime (no trailing slash); written into the agent card at /.well-known/agent-card.json.
# A2A_PUBLIC_URL=https://endpoint-xxxxxxxx.agentbase-runtime.aiplatform.vngcloud.vn

# --- Langfuse tracing (optional): set all three to trace every turn ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
