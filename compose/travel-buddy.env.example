# Environment of the travel-buddy container (docker compose --profile all).
# Copy to compose/travel-buddy.env. These are the variables of sample-travel-buddy: see its
# README (Steps 1-3) for how to create each resource. Values that start with "change-me" are
# rejected by that agent at startup.
# Do not put comments after a value: `docker run --env-file` keeps them as part of the value.

LLM_API_KEY=change-me
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=z-ai/glm-5.3-flash
AGENTBASE_MEMORY_ID=change-me
MEMORY_STRATEGY_PREF_ID=change-me
MEMORY_STRATEGY_FACTS_ID=change-me
# Connector endpoint of Tavily on your MCP Gateway: <gateway-url>/tavily
MCP_TAVILY_URL=change-me

# Locally the agent needs a service account that may call Memory and the MCP Gateway.
GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=

# Optional: when set, the orchestrator must send the same value as A2A_AGENT_TRAVEL_BUDDY_API_KEY.
# AGENT_API_KEY=change-me
